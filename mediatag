package com.example.mediatag.mixin;

import com.example.mediatag.MediaTag;
import net.minecraft.client.MinecraftClient;
import net.minecraft.client.gui.hud.PlayerListHud;
import net.minecraft.client.network.PlayerListEntry;
import net.minecraft.text.Text;
import org.spongepowered.asm.mixin.Mixin;
import org.spongepowered.asm.mixin.injection.At;
import org.spongepowered.asm.mixin.injection.Inject;
import org.spongepowered.asm.mixin.injection.callback.CallbackInfoReturnable;

/** Adds the tag to your own row in the tab list. Client-only. */
@Mixin(PlayerListHud.class)
public abstract class PlayerListHudMixin {
    @Inject(method = "getPlayerName", at = @At("RETURN"), cancellable = true)
    private void mediatag$addTag(PlayerListEntry entry, CallbackInfoReturnable<Text> cir) {
        MinecraftClient mc = MinecraftClient.getInstance();
        if (mc == null || mc.player == null || mc.getNetworkHandler() == null) return;
        PlayerListEntry self = mc.getNetworkHandler().getPlayerListEntry(mc.player.getUuid());
        if (self != null && self == entry) {
            cir.setReturnValue(MediaTag.prefix(cir.getReturnValue()));
        }
    }
}

package com.example.mediatag.mixin;

import net.minecraft.client.MinecraftClient;
import net.minecraft.client.render.entity.LivingEntityRenderer;
import net.minecraft.entity.LivingEntity;
import org.spongepowered.asm.mixin.Mixin;
import org.spongepowered.asm.mixin.injection.At;
import org.spongepowered.asm.mixin.injection.Inject;
import org.spongepowered.asm.mixin.injection.callback.CallbackInfoReturnable;

/** Vanilla never draws your own name tag; force it on when in third person. */
@Mixin(LivingEntityRenderer.class)
public abstract class LivingEntityRendererMixin {
    @Inject(method = "hasLabel", at = @At("HEAD"), cancellable = true)
    private void mediatag$showOwnLabel(LivingEntity entity, double squaredDistanceToCamera,
                                       CallbackInfoReturnable<Boolean> cir) {
        MinecraftClient mc = MinecraftClient.getInstance();
        if (mc != null && entity == mc.player
                && !mc.options.getPerspective().isFirstPerson()
                && MinecraftClient.isHudEnabled()) {
            cir.setReturnValue(true);
        }
    }
}

package com.example.mediatag.mixin;

import com.example.mediatag.MediaTag;
import net.minecraft.client.MinecraftClient;
import net.minecraft.entity.Entity;
import net.minecraft.text.Text;
import org.spongepowered.asm.mixin.Mixin;
import org.spongepowered.asm.mixin.injection.At;
import org.spongepowered.asm.mixin.injection.Inject;
import org.spongepowered.asm.mixin.injection.callback.CallbackInfoReturnable;

/** Adds the tag to your own name tag (visible in third person). Client-only. */
@Mixin(Entity.class)
public abstract class EntityMixin {
    @Inject(method = "getDisplayName", at = @At("RETURN"), cancellable = true)
    private void mediatag$addTag(CallbackInfoReturnable<Text> cir) {
        MinecraftClient mc = MinecraftClient.getInstance();
        if (mc != null && mc.player != null && (Object) this == mc.player) {
            cir.setReturnValue(MediaTag.prefix(cir.getReturnValue()));
        }
    }
}

package com.example.mediatag;

import net.minecraft.text.MutableText;
import net.minecraft.text.Text;
import net.minecraft.util.Formatting;

public final class MediaTag {
    private MediaTag() {}

    /** Change the look of the tag here. */
    public static MutableText tag() {
        return Text.literal("[MEDIA] ").formatted(Formatting.RED, Formatting.BOLD);
    }

    public static Text prefix(Text original) {
        return tag().append(original);
    }
}

{
  "required": true,
  "minVersion": "0.8",
  "package": "com.example.mediatag.mixin",
  "compatibilityLevel": "JAVA_21",
  "client": [
    "EntityMixin",
    "PlayerListHudMixin",
    "LivingEntityRendererMixin"
  ],
  "injectors": { "defaultRequire": 1 }
}

{
  "schemaVersion": 1,
  "id": "mediatag",
  "version": "${version}",
  "name": "Media Tag",
  "description": "Client-side only: shows a Media tag on yourself and in the tab list.",
  "authors": ["you"],
  "license": "MIT",
  "environment": "client",
  "mixins": ["mediatag.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.8",
    "java": ">=21"
  }
}

plugins {
    id 'fabric-loom' version '1.10-SNAPSHOT'
}

version = project.mod_version
group = project.maven_group
base { archivesName = project.archives_base_name }

repositories {}

dependencies {
    minecraft "com.mojang:minecraft:${project.minecraft_version}"
    mappings "net.fabricmc:yarn:${project.yarn_mappings}:v2"
    modImplementation "net.fabricmc:fabric-loader:${project.loader_version}"
    modImplementation "net.fabricmc.fabric-api:fabric-api:${project.fabric_version}"
}

processResources {
    inputs.property "version", project.version
    filesMatching("fabric.mod.json") { expand "version": inputs.properties.version }
}

tasks.withType(JavaCompile).configureEach {
    it.options.release = 21
}

java {
    withSourcesJar()
    sourceCompatibility = JavaVersion.VERSION_21
    targetCompatibility = JavaVersion.VERSION_21
}

